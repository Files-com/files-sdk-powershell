<?xml version="1.0" encoding="utf-8"?>
<!--
  The FilesCom SDK package comes only from the directory FILESCOM_ENGINE_FEED names, which build.sh checks holds the
  exact package engine.json records. Every other package comes from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="filescom-engine" value="%FILESCOM_ENGINE_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="filescom-engine">
      <package pattern="FilesCom" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
